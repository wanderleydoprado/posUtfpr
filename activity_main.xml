<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Linha Jogador 1 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/tvNomeJogador1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Jogador 1: "
            android:textSize="18sp" />

        <TextView
            android:id="@+id/tvPontosJogador1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Botões de Pontos Jogador 1 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="24dp">

        <Button
            android:id="@+id/btnJ1Mais1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:padding="4dp"
            android:text="+1" />

        <Button
            android:id="@+id/btnJ1Mais3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:padding="4dp"
            android:text="+3" />

        <Button
            android:id="@+id/btnJ1Mais6"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:padding="4dp"
            android:text="+6" />

        <Button
            android:id="@+id/btnJ1Mais9"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:padding="4dp"
            android:text="+9" />

        <Button
            android:id="@+id/btnJ1Mais12"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:padding="4dp"
            android:text="+12" />
    </LinearLayout>

    <!-- Linha Jogador 2 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/tvNomeJogador2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Jogador 2: "
            android:textSize="18sp" />

        <TextView
            android:id="@+id/tvPontosJogador2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Botões de Pontos Jogador 2 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="32dp">

        <Button
            android:id="@+id/btnJ2Mais1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:padding="4dp"
            android:text="+1" />

        <Button
            android:id="@+id/btnJ2Mais3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:padding="4dp"
            android:text="+3" />

        <Button
            android:id="@+id/btnJ2Mais6"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:padding="4dp"
            android:text="+6" />

        <Button
            android:id="@+id/btnJ2Mais9"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:padding="4dp"
            android:text="+9" />

        <Button
            android:id="@+id/btnJ2Mais12"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:padding="4dp"
            android:text="+12" />
    </LinearLayout>

    <!-- Botões de Ação -->
    <Button
        android:id="@+id/btnHistJogadas"
        android:layout_width="180dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="Hist. de Jogadas" />

    <Button
        android:id="@+id/btnZerarHistorico"
        android:layout_width="180dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="Zerar Histórico" />

    <Button
        android:id="@+id/btnInfNomes"
        android:layout_width="180dp"
        android:layout_height="wrap_content"
        android:text="Inf. Nomes" />

</LinearLayout>
